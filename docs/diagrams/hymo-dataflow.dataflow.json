    {
      "title": "Binary Shard Architecture",
      "dot": "emerald",
      "items": [
        "Fixed 50M-token binary chunks stored as raw uint32 arrays (120 GB total on disk)",
        "Zero-copy np.memmap access with negligible RAM footprint during training",
        "Resumable deterministic shuffle maintains training reproducibility"
      ]
    },
    {
      "title": "MTP Multi-Token Alignment",
      "dot": "amber",
      "items": [
        "Dataset extracts windows of S+2 contiguous tokens: input x = chunk[:S]",
        "Primary target y_0 = chunk[1:S+1], depth-1 target y_1 = chunk[2:S+2]",
        "Zero token padding: non-full shard tails are cleanly dropped"
      ]
    }
