  "cards": [
    {
      "title": "Configured update clock",
      "dot": "cyan",
      "items": [
        "configs/hymo_750m.yaml at a88006236ad8a96f17f86298da7fa9afb8c844ad.",
        "8 micro-batches/update. Log every 50, evaluate every 2,000, save every 4,000 optimizer updates. Best validation loss also triggers save.",
        "src/hymo/training/trainer.py:Trainer.train_step clips at 1.0, sets LR, steps optimizers, updates MoE bias and advances scheduler."
      ]
    },
    {
      "title": "Loss and skip semantics",
      "dot": "amber",
      "items": [
        "Materialized main logits feed ordinary cross_entropy, not chunked CE. Main loss slices logits and supplied targets to :-1.",
        "MTP weights are 0.3 and 0.1. Auxiliary target/conditioning correctness is a separate investigation.",
        "Nonfinite loss clears gradients and returns skipped without incrementing micro_step. There is no five-failure rollback."
      ]
    },
    {
      "title": "Persistence, not exact resume",
      "dot": "slate",
      "items": [
        "src/hymo/training/checkpoint.py:save_checkpoint writes DCP tensors and hymo_meta.json with RNG/counters. Only JSON uses temporary-file replacement.",
        "No sampler position, pending gradients or micro_step are restored. Trainer.train does not guarantee a final checkpoint on exit.",
        "NorMuon handles remaining dense 2D matrices. AdamW owns embeddings/head, experts, gates, norms, scalars and non-2D parameters."
      ]
    }
  ]
